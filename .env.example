# =========================================================
#  Variables de entorno — Casa
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA subas el archivo .env con valores reales.
#
#  La app no tiene cuentas ni envía correo, así que la lista es corta.
# =========================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos PostgreSQL (Neon, Supabase, local…) ---
# Obligatoria: es donde vive el estado de la casa. Sin ella, la app arranca
# pero no puede guardar nada.
DATABASE_URL=

# --- Huso horario de la casa ---
# Decide cuándo empieza la semana y cuándo cambia el mes. Lo marca el reloj del
# SERVIDOR, no el del móvil de cada uno: así un dispositivo con la fecha mal
# puesta no reinicia el mes de todos.
TZ_FAMILIA=Europe/Madrid

# --- App de Android (TWA) ---
# Solo hace falta si publicas la app en Google Play. La huella SHA-256 la da
# Play Console después de subirla por primera vez.
ANDROID_FINGERPRINT=
ANDROID_PACKAGE=com.casa.tareas
