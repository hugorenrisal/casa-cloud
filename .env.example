# =========================================================
#  Variables de entorno — Casa Cloud
#  Copia este archivo a .env y rellena los valores reales.
#  NUNCA commitees el archivo .env con valores reales.
# =========================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos PostgreSQL (Neon, Supabase, local, etc.) ---
# Si no se define, la app usa archivo data.json local (solo dev/test).
# Para producción, usar siempre DATABASE_URL.
DATABASE_URL=

# --- JWT ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-bytes
JWT_EXPIRES_IN=7d

# --- Gmail SMTP (envío de emails) ---
# GMAIL_USER: la dirección de Gmail completa (tunombre@gmail.com).
# GMAIL_APP_PASSWORD: una "contraseña de aplicación" de 16 letras, NO la
# contraseña normal de la cuenta. Requiere verificación en dos pasos activada.
# Se genera en: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM=Casa <tunombre@gmail.com>

# --- App ---
APP_URL=http://localhost:3000
INVITATION_EXPIRES_HOURS=168
RESET_TOKEN_EXPIRES_MINUTES=60
VERIFY_TOKEN_EXPIRES_HOURS=24

# --- Modo email en desarrollo ---
# Si faltan GMAIL_USER o GMAIL_APP_PASSWORD, los emails se imprimen en
# consola en vez de enviarse.
